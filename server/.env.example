PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Local dev default (plain SQLite file) — leave unset to use it:
# DATABASE_URL=file:./data/jarvys.db

# Hosted (Turso): from `turso db show <name> --url` and `turso db tokens create <name>`
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# Free open-source model inference (groq.com — no credit card).
# Leave unset and /assistant/chat just echoes your message back.
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=qwen/qwen3.6-27b

# Optional: powers "extended thinking" for hard questions the assistant
# flags on its own. Free at aistudio.google.com — Groq's free tier doesn't
# leave enough output-token room for both deep reasoning and a full answer,
# so approved thinking requests route here instead. Without this set, the
# assistant still asks before attempting hard questions, it just explains
# it can't think deeper yet rather than actually doing it.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
